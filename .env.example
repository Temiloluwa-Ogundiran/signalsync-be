APP_NAME=SyncTrades API
DEBUG=false
IS_PRODUCTION=true
PORT=8000
AUTO_SEED_ON_STARTUP=true

DATABASE_URL=postgresql://synctrades:synctrades@postgres:5432/synctrades

SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ENCRYPTION_KEY=

FRONTEND_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Google Sign-In — OAuth 2.0 Web client ID (from Google Cloud Console).
# ID tokens are verified server-side with this as the expected audience.
# Must match the client ID used by the frontend. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

MT5_CORE_URL=http://mt5-quant-server:8000
MT5_CORE_INTERNAL_SHARED_SECRET=change-me
MT5_CORE_POLL_TIMEOUT_SECONDS=120
MT5_CORE_POLL_INTERVAL_SECONDS=2
INITIAL_SYNC_LOOKBACK_DAYS=14

EMAIL_VERIFY_EXPIRY_HOURS=24
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=SyncTrades

# Object storage — AWS S3 (private bucket; reads via presigned GET URLs)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom/S3-compatible endpoint (leave blank for real AWS S3)
AWS_S3_ENDPOINT_URL=
MEDIA_SIGNED_URL_TTL_SECONDS=3600
VOICE_SIGNED_URL_TTL_SECONDS=3600
IMAGE_SIGNED_URL_TTL_SECONDS=3600

RATE_LIMIT_REDIS_URL=redis://localhost:6379/2

# AI — the backend talks to OpenAI directly (no external AI service).
# OPENAI_API_KEY is required for AI features to work; the agent only
# initialises at startup when AI_ENABLED is true and this key is present.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.0
AI_ENABLED=true
# Redis for AI quota tracking + tool-result caching.
AI_REDIS_URL=redis://localhost:6379/3