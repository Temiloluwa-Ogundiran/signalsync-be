APP_NAME=SyncTrades API
DEBUG=false
IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Custom storage microservice (S3) — preferred for new uploads when set
# ---------------------------------------------------------------------------
STORAGE_SERVICE_BASE_URL=
STORAGE_SERVICE_UPLOAD_PATH=/api/upload
STORAGE_SERVICE_API_KEY=
STORAGE_SERVICE_PRESIGNED_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/<project-ref>/settings/api
# Required only while legacy Storage paths (keys containing "/") still exist.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-secret>

# ---------------------------------------------------------------------------
# Supabase Storage — create these buckets in the Supabase dashboard first
#   Dashboard → Storage → New bucket
#   Recommended: set both buckets to Public so images are accessible via URL
# ---------------------------------------------------------------------------
SUPABASE_STREAM_AVATARS_BUCKET=stream-avatars
SUPABASE_STREAM_BANNERS_BUCKET=stream-banners
SUPABASE_POST_MEDIA_BUCKET=post-media
JOURNAL_VOICE_BUCKET=journal-voice-notes
JOURNAL_IMAGES_BUCKET=journal-images
MEDIA_SIGNED_URL_TTL_SECONDS=3600
VOICE_SIGNED_URL_TTL_SECONDS=3600
IMAGE_SIGNED_URL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# MetaAPI
# ---------------------------------------------------------------------------
METAAPI_TOKEN=
METAAPI_VERIFY_SSL=true
METAAPI_PROVISIONING_BASE_URL=
METAAPI_CLIENT_BASE_URL=
METAAPI_ACCOUNT_ENGINE=
METAAPI_ACCOUNT_MAGIC=
METAAPI_DEALS_TIMEOUT_SECONDS=45
METAAPI_DEALS_MAX_RETRIES=3
METAAPI_DEALS_RETRY_BACKOFF_SECONDS=1.5
INITIAL_SYNC_LOOKBACK_DAYS=30
ENCRYPTION_KEY=
SYNC_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Database — use the Session Pooler URL from Supabase dashboard
#   Dashboard → Project Settings → Database → Connection string → Session pooler
#   Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   The Session Pooler (port 5432) is recommended for SQLAlchemy's QueuePool.
#   Do NOT use the Transaction Pooler (port 6543) — it doesn't support prepared statements.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Auth — generate a strong random secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Frontend URL — used to build the verification link inside the email
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS allowlist for browser requests to the API.
# Use either comma-separated values OR a JSON array.
# Comma-separated example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://synctrades-fe.netlify.app,https://www.synctrades-fe.netlify.app
# JSON array example:
# CORS_ALLOWED_ORIGINS=["http://localhost:3000","https://synctrades-fe.netlify.app","https://www.synctrades-fe.netlify.app"]
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------
EMAIL_VERIFY_EXPIRY_HOURS=24

# ---------------------------------------------------------------------------
# SMTP — fill these in to enable real email sending.
# For Gmail: SMTP_SERVER=smtp.gmail.com, SMTP_PORT=587
#   Use an App Password (not your account password):
#   https://myaccount.google.com/apppasswords
# For any other provider, use the values they give you.
# ---------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=SyncTrades

# ---------------------------------------------------------------------------
# Mobile deep link (optional)
# Set this if you have a mobile app that registers a custom URL scheme.
# Example: synctrades://
# When platform=mobile is passed to the verify-email endpoint the user
# is redirected here instead of FRONTEND_URL.
# ---------------------------------------------------------------------------
DEEP_LINK_SCHEME=