# Required by config.py
DATABASE_URL=postgresql://synctrades:synctrades@postgres:5432/synctrades
SECRET_KEY=change-me-to-a-long-random-secret

# Production URLs
FRONTEND_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com

# Broker credential encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com

# MT5 core service
MT5_CORE_URL=https://your-mt5-core-domain.com
MT5_CORE_INTERNAL_SHARED_SECRET=change-me

# AI copilot
OPENAI_API_KEY=

# Object storage - AWS S3 or S3-compatible storage
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only if your bucket is not in config.py's default region, us-east-1.
AWS_S3_REGION=

# Redis service URLs for Docker/container deployments
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
AI_REDIS_URL=redis://redis:6379/3
